KB_HOST=0.0.0.0
KB_PORT=8000
KB_DATA_DIR=./data
KB_LOG_LEVEL=INFO
KB_TIMEZONE=Europe/Berlin

# Pfad zum Fernet-Master-Key (32-Byte urlsafe base64).
# Bei leer werden lokal keine Credentials verschlüsselt persistiert.
KB_SECRET_FILE=

# Aufstellungs-Writes (POST /lineup). Default aus — das ist die einzige
# Aktion, die unmittelbar Punkte bewegt, und eine falsch geschriebene Elf
# holt kein späterer Tick zurück. Bei `false` protokolliert der Startelf-Guard
# nur, was er getan hätte (im trade_log als SET_LINEUP mit executed=false).
# Erst auf `true` stellen, wenn diese Einträge eine Woche lang gegen die
# Kickbase-App geprüft wurden.
KB_LINEUP_WRITES_ENABLED=false

# --- Liga-Einstellungen, die die Kickbase-API nicht herausgibt ---
#
# `/v4/leagues/{id}/settings` existiert nicht (HTTP 500 NotFound), und `/me`
# liefert nur das Kaderlimit (`mppu`) und die aktuelle Verteilung je Verein.
# Die folgenden drei Werte stehen in der App unter Liga -> Admin-Einstellungen:
# ablesbar, aber nicht abrufbar. Ohne Eintrag gelten sie als unbekannt — das
# Modell bekommt dann `null` plus ein missing_data-Flag und behauptet keinen
# Verstoss, den es nicht kennt.

# Spielerlimit pro Verein: eine Zahl (1..11) oder `unlimited`.
# `unlimited` ist eine Antwort, Weglassen ist keine — der Bot haelt sich bei
# unbekanntem Limit vorsichtshalber an hoechstens drei Spieler je Verein.
KB_CLUB_LIMIT=unlimited

# Admin-Option "Unterbieten deaktivieren".
# true  = JEDES Gebot unter Marktwert ist blockiert.
# false = Kickbase laesst bis Marktwert minus 10 % zu.
KB_UNDERPAY_BLOCKED=true

# Wertungsmodus: `season_points` (Summe aller Spieltagspunkte gewinnt) oder
# `head_to_head` (Duell pro Spieltag, 3/1/0). Head-to-Head belohnt Varianz
# gegen starke Gegner, Saisonpunkte nicht.
KB_SCORING_MODE=season_points
