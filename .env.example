KB_HOST=0.0.0.0
KB_PORT=8000
KB_DATA_DIR=./data
KB_LOG_LEVEL=INFO
KB_TIMEZONE=Europe/Berlin

# Pfad zum Fernet-Master-Key (32-Byte urlsafe base64).
# Bei leer werden lokal keine Credentials verschlüsselt persistiert.
KB_SECRET_FILE=

# Aufstellungs-Writes (POST /lineup). Default aus — das ist die einzige
# Aktion, die unmittelbar Punkte bewegt, und eine falsch geschriebene Elf
# holt kein späterer Tick zurück. Bei `false` protokolliert der Startelf-Guard
# nur, was er getan hätte (im trade_log als SET_LINEUP mit executed=false).
# Erst auf `true` stellen, wenn diese Einträge eine Woche lang gegen die
# Kickbase-App geprüft wurden.
KB_LINEUP_WRITES_ENABLED=false
